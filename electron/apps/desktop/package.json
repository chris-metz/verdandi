{
  "name": "@verdandi/desktop",
  "productName": "Verdandi",
  "description": "A desktop client for GitHub issues across many repositories.",
  "version": "0.0.0",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "install-electron && electron-vite dev --watch",
    "build": "electron-vite build",
    "start": "install-electron && electron-vite preview",
    "package": "electron-vite build && electron-builder --dir",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/renderer/tsconfig.json",
    "icons": "install-electron && electron scripts/render-icons.mjs"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@verdandi/core": "workspace:*",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "elkjs": "^0.12.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^7.3.6"
  }
}
